# Backend
ZUS_RULES_PATH=../zus_rules/03_rules.yaml
CORS_ORIGINS=http://localhost:3000
LAW_REFERENCE_DATE=2026-11-21
# Token panelu admina (nagłówek X-Admin-Token, kontrakt: securitySchemes.AdminToken) — ustaw własny, nie commituj .env
ADMIN_TOKEN=zmien-mnie

# Frontend (wbudowywane przy buildzie Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
# real | mock — mock pokazuje baner „TRYB DEMO” i nie łączy się z backendem
NEXT_PUBLIC_API_MODE=real
